# Modelo de chaves do Workfoli.
# Copie este arquivo para ".env" e preencha só o que for usar.
# O .env nunca vai pro GitHub (está no .gitignore).

# Fotos com IA no /carrossel (basta uma das duas)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Publicação automática no Instagram + Facebook (/aprovar-post)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
SITE_URL=https://seudominio.com.br

# Coleta de dados públicos do Instagram no /nicho-instagram (opcional, gasta créditos da Apify)
APIFY_TOKEN=
